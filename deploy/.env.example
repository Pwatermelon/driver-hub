# Пример локального .env для ручного деплоя на сервер.
# В GitHub Actions эти значения приходят из secrets (Environment production).

DOMAIN=hackton-test.ru
ACME_EMAIL=admin@hackton-test.ru
DEPLOY_PATH=/opt/driver-hub
JWT_SECRET=change-me
# Пароль Postgres отдельно (НЕ копируй JWT сюда, если в нём есть @ # / % и т.п.)
POSTGRES_PASSWORD=driverhub
DATABASE_URL=postgres://driverhub:driverhub@db:5432/driverhub?sslmode=disable
PUBLIC_BASE_URL=https://hackton-test.ru
ESIA_MODE=mock
SEED_DEMO=true
# IMAGE_API=ghcr.io/<owner>/driver-hub-api:0.1.1
# IMAGE_WEB=ghcr.io/<owner>/driver-hub-web:0.1.1
