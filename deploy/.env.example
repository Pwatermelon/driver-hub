# Пример локального .env для ручного деплоя на сервер.
# В GitHub Actions эти значения приходят из secrets (Environment production).

DOMAIN=hackton-test.ru
ACME_EMAIL=admin@hackton-test.ru
DEPLOY_PATH=/opt/driver-hub
JWT_SECRET=change-me
PUBLIC_BASE_URL=https://hackton-test.ru
ESIA_MODE=mock
SEED_DEMO=true
