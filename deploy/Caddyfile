{
	email {$ACME_EMAIL}
}

:80 {
	handle /healthz {
		reverse_proxy web:80
	}
	handle {
		redir https://{host}{uri} permanent
	}
}

{$DOMAIN:localhost} {
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
	}

	# Весь трафик в web (nginx): статика + /api и /healthz проксируются на api
	# Не используем zstd — Safari даёт "Load failed"
	handle {
		encode gzip
		reverse_proxy web:80 {
			header_up X-Forwarded-Proto {scheme}
			header_up X-Real-IP {remote_host}
		}
	}

	log {
		output stdout
		format console
	}
}

# Планировщик (planning-tool) на хосте :8010 (должен слушать 0.0.0.0, не только 127.0.0.1)
# DNS: plan.<DOMAIN> → IP сервера. BotFather /setdomain → plan.<DOMAIN>
plan.{$DOMAIN} {
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
	}

	encode gzip
	reverse_proxy host.docker.internal:8010 {
		header_up Host {host}
		header_up X-Forwarded-Proto {scheme}
		header_up X-Real-IP {remote_host}
		health_uri /api/healthz
		health_interval 30s
		health_timeout 5s
	}

	log {
		output stdout
		format console
	}
}
